# Copy to scripts/.env; scripts/swiftbasket.sh loads it on start.

# Stripe test-mode secret key: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_replace_me
# Enables the test "Pay" button; leave unset to hide it.
STRIPE_TEST_PAYMENT_METHOD_ID=pm_card_visa
# Only needed to test signed Stripe webhooks (stripe listen prints one).
STRIPE_WEBHOOK_SECRET=

# Mailtrap Email Testing inbox -> SMTP settings
MAILTRAP_USERNAME=replace_me
MAILTRAP_PASSWORD=replace_me

# JWT signing secret, at least 64 bytes: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=replace_with_a_long_random_value
